# DBGuard Configuration Template

# Server Port
PORT=5000

# Database Engine Mode:
# "sqlite" for zero-dependency local in-process InnoDB concurrency engine (Default)
# "mysql" for native external MySQL 8.x Server
DB_MODE=sqlite

# Native MySQL 8.x Configuration (Used when DB_MODE=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=dbguard

# JWT Secret
JWT_SECRET=dbguard_super_secret_signing_key_2026
